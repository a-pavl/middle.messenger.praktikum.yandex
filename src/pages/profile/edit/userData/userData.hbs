<div class="container">
    <div class="redirect-back">
        {{{ Input name="redirectToProfile" type="image"
            src=redirectBackIcon
            onClick=onRedirect
        }}}
    </div>
    <div class="content-container">
        <div class="profile">
            <div class="profile__avatar">
                {{{ Label image=user.avatar className="profile__avatar-input" onClick=onAvatarClick }}}
            </div>
            <div class="profile__details">
                <div class="profile__detail">
                    {{{ Label label="Почта" name="email"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="email" type="text" value=user.email
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.email
                        ref="email"
                    }}}
                </div>
                <div class="profile__detail">
                    {{{ Label label="Логин" name="login"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="login" type="text" value=user.login
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.login
                        ref="login"
                    }}}
                </div>
                <div class="profile__detail">
                    {{{ Label label="Имя" name="first_name"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="first_name" type="text" value=user.first_name
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.name
                        ref="first_name"
                    }}}
                </div>
                <div class="profile__detail">
                    {{{ Label label="Фамилия" name="second_name"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="second_name" type="text" value=user.second_name
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.name
                        ref="second_name"
                    }}}
                </div>
                <div class="profile__detail">
                    {{{ Label label="Имя в чате" name="display_name"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="display_name" type="text" value=user.display_name
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.name
                        ref="display_name"
                    }}}
                </div>
                <div class="profile__detail">
                    {{{ Label label="Телефон" name="phone"
                        className="profile__detail-label"
                    }}}
                    {{{ InputField name="phone" type="text" value=user.phone
                        className="profile__detail-input"
                        inputFieldClassName="input-field__profile"
                        validate=validationRules.phone
                        ref="phone"
                    }}}
                </div>
            </div>
            <div class="profile__buttons">
                {{{ Button label="Сохранить" className="profile__button-confirm" onClick=onSubmit }}}
            </div>
        </div>
    </div>

    {{#with modalConfigs.editAvatar}}
        {{#if showModal}}
            {{{ Modal title="Загрузить файл"
                content=content
                buttonLabel="Поменять"
                onClick=onClose
                onSubmit=onSubmit
                ref="editAvatar"
            }}}
        {{/if}}
    {{/with}}
</div>
