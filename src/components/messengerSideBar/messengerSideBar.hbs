<div class="side-bar">
    <div class="side-bar__header">
        <div class="side-bar__header-actions">
            <div class="side-bar__header-addChatAction">
                {{{ Input name="addChatButton" type="image"
                    src=createChatIcon
                    onClick=onAddChat
                }}}
            </div>
            <div>
                {{{ Button label="Profile >" className="action-button" onClick=onRedirectToProfile }}}
            </div>
        </div>
        <div class="side-bar__header-search">
            {{{ ChatSearch name="search" type="text"  
                placeholder="Search"
                onInput=onInput
                ref="search"
            }}}
        </div>
    </div>
    <div class="side-bar__content">
        {{{ ChatCardList chatList=chats ref="chatCardList" }}}
    </div>

    {{#with modalConfigs.addChat}}
        {{#if showModal}}
            {{{ Modal title="Добавить чат"
                content=content
                buttonLabel="Добавить"
                onClick=onClose
                onSubmit=onSubmit
                ref="addChat"
            }}}
        {{/if}}
    {{/with}}
</div>
