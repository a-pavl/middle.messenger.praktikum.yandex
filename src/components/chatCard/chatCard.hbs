<div class="card">
    <img class="card__avatar" src={{chat.avatar}} alt="Иконка чата"></image>
    <div class="card__info">
        <div class="card__label">
            <div class="card__label-name">
                {{chat.title}}
            </div>
            <div class="card__label-date">
                {{chat.last_message.timeFormatted}}
            </div>
        </div>
        <div class="card__details">
            <div class="card__details-text">
                {{chat.last_message.content}}
            </div>
            {{#if showChatCounter}}
                <div class="card__details-counter">
                    {{chat.unread_count}}
                </div>
            {{/if}}
        </div>
    </div>
</div>
